<?php

/**
 * @file
 * Per-service-area context: computed node fields + cache invalidation.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\psp_service_area\AreaResolver;
use Drupal\psp_service_area\Field\AreaValueItemList;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_entity_base_field_info().
 *
 * Computed, area-derived values on every node so Canvas content templates
 * can bind CTA buttons to them (with global fallbacks) instead of
 * hardcoding phone numbers and booking URLs per template.
 */
function psp_service_area_entity_base_field_info(EntityTypeInterface $entity_type): array {
  $fields = [];
  if ($entity_type->id() === 'node') {
    $definitions = [
      'psp_area_phone_uri' => t('Service area phone (tel: URI)'),
      'psp_area_phone_display' => t('Service area phone (display)'),
      'psp_area_booking_url' => t('Service area booking URL'),
    ];
    foreach ($definitions as $name => $label) {
      $fields[$name] = BaseFieldDefinition::create('string')
        ->setLabel($label)
        ->setDescription(t("Derived from the node's Service area term, falling back to the site-wide default."))
        ->setComputed(TRUE)
        ->setClass(AreaValueItemList::class)
        ->setReadOnly(TRUE)
        ->setTranslatable(FALSE)
        ->setDisplayConfigurable('view', FALSE)
        ->setDisplayConfigurable('form', FALSE);
    }
  }
  return $fields;
}

/**
 * Implements hook_theme().
 */
function psp_service_area_theme(): array {
  return [
    'psp_phone_directory' => [
      'variables' => ['markets' => [], 'compact' => FALSE],
    ],
    'psp_location_selector' => [
      'variables' => ['locations' => [], 'compact' => FALSE],
    ],
    'psp_footer_locations' => [
      'variables' => ['locations' => []],
    ],
    'psp_location_bar' => [
      'variables' => [
        'current' => NULL,
        'locations' => [],
        'fallback_phone' => NULL,
        'fallback_phone_uri' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 *
 * Emits schema.org LocalBusiness JSON-LD on any page inside a service
 * area, built from the area term (address, phone, landing URL, Google
 * Business profile via the Map link field).
 */
function psp_service_area_page_attachments(array &$attachments): void {
  $term = \Drupal::service('psp_service_area.area_resolver')->resolve();
  $attachments['#cache']['contexts'][] = 'service_area';
  $attachments['#cache']['tags'][] = 'taxonomy_term_list:' . AreaResolver::VOCABULARY;
  if (!$term) {
    return;
  }

  $settings = \Drupal::config('psp_service_area.settings');
  $company = $settings->get('default_company_name');
  $base = \Drupal::request()->getSchemeAndHttpHost();
  $prefix = trim((string) $term->get('field_path_prefix')->value, "/ \t\n");
  $url = $base . '/' . $prefix;

  // The site's trades come from psp_seo.settings so market blocks and the
  // sitewide entity emitted by psp_seo always advertise the same types.
  $seo = \Drupal::config('psp_seo.settings');
  $attachments['#cache']['tags'] = Cache::mergeTags($attachments['#cache']['tags'] ?? [], $seo->getCacheTags());
  $types = array_values(array_filter((array) $seo->get('business_types')));

  $data = [
    '@context' => 'https://schema.org',
    '@type' => $types ?: ['Plumber', 'HVACBusiness'],
    '@id' => $url . '#business',
    'name' => $company . ' - ' . $term->getName(),
    'url' => $url,
  ];
  if ($seo->get('company_name')) {
    // psp_seo emits the umbrella Organization with this @id on every page.
    $data['parentOrganization'] = ['@id' => $base . '/#organization'];
  }
  if ($phone = $term->get('field_phone')->value) {
    $data['telephone'] = '+1-' . preg_replace('/[^0-9\-]/', '', $phone);
  }
  if ($address = $term->get('field_address')->value) {
    $lines = preg_split('/\r\n|\r|\n/', trim($address));
    $last = array_pop($lines);
    $postal = [];
    if (preg_match('/^(.*?),\s*([A-Z]{2})\s+(\d{5})/', $last, $m)) {
      $postal = [
        'addressLocality' => $m[1],
        'addressRegion' => $m[2],
        'postalCode' => $m[3],
      ];
    }
    else {
      $lines[] = $last;
    }
    $data['address'] = [
      '@type' => 'PostalAddress',
      'streetAddress' => implode(', ', $lines),
      'addressCountry' => 'US',
    ] + $postal;
  }
  if ($map = $term->get('field_map_link')->uri) {
    $data['hasMap'] = $map;
  }
  if ($booking = $term->get('field_booking_url')->uri) {
    $data['potentialAction'] = [
      '@type' => 'ReserveAction',
      'target' => $booking,
    ];
  }

  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      // Markup + JSON_HEX_* : keeps entities out of the raw script text
      // (parsers do not HTML-decode) while blocking </script> breakout.
      '#value' => \Drupal\Core\Render\Markup::create(json_encode($data, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)),
    ],
    'psp_service_area_local_business',
  ];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for taxonomy_term.
 *
 * Area data (phone, booking URL, address, menu) is baked into render-cached
 * nodes, blocks and pages that carry no term-specific cache tags. Terms in
 * this vocabulary change rarely, so a blunt render-cache invalidation on
 * save is the simple, correct trade-off.
 */
function psp_service_area_taxonomy_term_presave(TermInterface $term): void {
  if ($term->bundle() === AreaResolver::VOCABULARY && !$term->isNew()) {
    Cache::invalidateTags(['rendered']);
  }
}
