{#
/**
 * @file
 * Booking card: a webform's first two questions (a choice and a date),
 * with an optional call button above the card.
 *
 * The day picker (quick days + calendar) is drawn by booking-card.js in the
 * visitor's own time zone; the choice chips render here. Nothing starts
 * selected.
 */
#}
{% set icon_arrow %}<svg class="psp-booking-card__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
{% set icon_phone %}<svg class="psp-booking-card__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6.6 3.5 9 3l1.6 4-2 1.4a12 12 0 0 0 7 7l1.4-2 4 1.6-.5 2.4A2.5 2.5 0 0 1 18 20 15 15 0 0 1 4 6a2.5 2.5 0 0 1 2.6-2.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>{% endset %}
{% set icon_prev %}<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
<div class="psp-booking">
{% if call_label and phone_display %}
  <a class="psp-booking__call" href="{{ phone_uri }}">{{ icon_phone }}<span>{{ call_label }} {{ phone_display }}</span></a>
{% endif %}
<div class="psp-booking-card{{ theme_name != 'inherit' ? ' theme--' ~ theme_name }}"
  data-theme="{{ theme_name }}"
  data-display="{{ display }}"
  data-form-url="{{ form_url }}"
  data-form-title="{{ form_title }}"
  data-choice-name="{{ choice_name }}"
  data-date-name="{{ date_name }}"
  data-months-ahead="{{ months_ahead }}">
  <div class="psp-booking-card__step" data-step="pick">
    <div class="psp-booking-card__head">
      {% if title %}<h2 class="psp-booking-card__title">{{ title }}</h2>{% endif %}
      {% if online_heading %}<h3 class="psp-booking-card__divider"><span>{{ online_heading }}</span></h3>{% endif %}
      {% if subtitle %}<p class="psp-booking-card__sub">{{ subtitle }}</p>{% endif %}
    </div>
    <div class="psp-booking-card__chips{{ choice_style == 'icons' ? ' psp-booking-card__chips--icons' }}" role="group" aria-label="{{ choice_label|default('Service'|t) }}">
      {% for option in options %}
        {% if choice_style == 'icons' %}
          <button type="button" class="psp-booking-card__chip psp-booking-card__trade" data-value="{{ option.value }}" aria-pressed="false">
            <span class="psp-booking-card__badge psp-booking-card__badge--{{ option.icon }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="{{ option.path }}"/></svg>
            </span>
            <span class="psp-booking-card__trade-label">{{ option.label }}</span>
          </button>
        {% else %}
          <button type="button" class="psp-booking-card__chip" data-value="{{ option.value }}" aria-pressed="false">{{ option.label }}</button>
        {% endif %}
      {% endfor %}
    </div>
    <div class="psp-booking-card__picker"></div>
    <p class="psp-booking-card__status visually-hidden" role="status"></p>
    <button type="button" class="psp-booking-card__cta">{{ button_label }} {{ icon_arrow }}</button>
  </div>
  {% if display == 'inline' %}
    <div class="psp-booking-card__step psp-booking-card__form" data-step="form" hidden>
      <button type="button" class="psp-booking-card__back">{{ icon_prev }}<span>{{ 'Change service or date'|t }}</span></button>
      <iframe class="psp-booking-card__frame" title="{{ form_title }}" loading="lazy"></iframe>
    </div>
  {% endif %}
</div>
</div>
