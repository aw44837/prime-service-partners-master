<?php

/**
 * @file
 * PSP Request Service: styling for the Request Service webform.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_theme().
 */
function psp_request_service_theme(): array {
  return [
    'psp_booking_card' => [
      'variables' => [
        'title' => '',
        'subtitle' => '',
        'button_label' => 'Continue',
        'display' => 'panel',
        'form_title' => '',
        'options' => [],
        'choice_name' => '',
        'choice_label' => '',
        'date_name' => '',
        'months_ahead' => 5,
        'form_url' => '',
        'theme_name' => 'white',
        'choice_style' => 'icons',
        'call_label' => '',
        'call_display' => 'button_above',
        'preselect' => '',
        'topic' => '',
        'market' => '',
        'call_link_intro' => '',
        'phone_display' => '',
        'phone_uri' => '',
        'online_heading' => '',
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for html__webform_share.
 *
 * Webform's share page (the Book Online panel and the booking card's form)
 * has its own html template, which Dripyard's colour preprocessor skips, so
 * --theme-setting-* colours were undefined there and the form fell back to a
 * default navy instead of the site's brand colour. Add them the same way.
 */
function psp_request_service_preprocess_html__webform_share(array &$variables): void {
  $theme = \Drupal::theme()->getActiveTheme()->getName();
  $colors = \Drupal::config($theme . '.settings')->get('theme_colors.colors') ?? [];
  $style = '';
  foreach ($colors as $name => $value) {
    if (is_string($value) && !str_contains($name, '_brightness') && preg_match('/^#[0-9a-fA-F]{3,8}$/', $value)) {
      $style .= '--theme-setting-' . str_replace('_', '-', $name) . ': ' . $value . '; ';
    }
  }
  if ($style !== '') {
    $existing = $variables['html_attributes']->hasAttribute('style') ? (string) $variables['html_attributes']->storage()['style'] : '';
    $variables['html_attributes']->setAttribute('style', $existing . $style);
  }
  // Dripyard picks white/black text on primary/secondary surfaces from these
  // <html> classes, and the site theme class sets the default surface.
  foreach (['primary', 'secondary'] as $which) {
    if (!empty($colors['base_' . $which . '_color_brightness'])) {
      $variables['html_attributes']->addClass($which . '-color-is-' . $colors['base_' . $which . '_color_brightness']);
    }
  }
  if ($site_theme = \Drupal::config($theme . '.settings')->get('theme_colors.site_theme')) {
    $variables['html_attributes']->addClass('theme--' . $site_theme);
  }

  // Opened from a booking card with a background choice (psp_theme): the
  // form page takes the same Dripyard theme as the card.
  $requested = (string) \Drupal::request()->query->get('psp_theme');
  if (in_array($requested, ['white', 'light', 'dark', 'black', 'primary', 'secondary'], TRUE)) {
    $classes = array_filter((array) ($variables['attributes']['class'] ?? []), fn($class) => !str_starts_with((string) $class, 'theme--'));
    $classes[] = 'theme--' . $requested;
    $variables['attributes']['class'] = array_values($classes);
  }
}

/**
 * Implements hook_webform_submission_form_alter().
 */
function psp_request_service_webform_submission_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Other webforms opt in to the same styling by adding the
  // psp-request-service-form class under Settings > Form > CSS classes.
  $webform = $form_state->getFormObject()->getEntity()->getWebform();
  $classes = $webform->getSetting('form_attributes')['class'] ?? [];
  if (str_starts_with($form_id, 'webform_submission_request_service_') || in_array('psp-request-service-form', $classes, TRUE)) {
    $form['#attributes']['class'][] = 'psp-request-service-form';
    $form['#attached']['library'][] = 'psp_request_service/form';
    // Request description: example text that follows the chosen service.
    $all = $webform->getElementsInitializedFlattenedAndHasValue();
    if (isset($all['comments'])) {
      foreach ($all as $key => $element) {
        if (isset($element['#options']) && ($element['#options_display'] ?? '') === 'buttons' && empty($element['#wrapper_attributes']['class'])) {
          $map = [];
          foreach (\Drupal\webform\Entity\WebformOptions::getElementOptions($element) as $value => $label) {
            if (is_string($label)) {
              $map[(string) $value] = \Drupal\psp_request_service\ServiceIcons::forLabel($label);
            }
          }
          $form['#attached']['drupalSettings']['pspServicePlaceholders'] = [
            'name' => $key,
            'map' => $map,
            'text' => array_map(fn($text) => (string) t($text), \Drupal\psp_request_service\ServiceIcons::PLACEHOLDERS),
            'default' => (string) t('Briefly describe what is going on so we can prepare.'),
          ];
          break;
        }
      }
    }
  }

  // Same-day follow-up: required when the date is today, dropped otherwise.
  // same-day.js shows/hides it in the browser.
  foreach ($webform->getElementsInitializedFlattenedAndHasValue() as $key => $element) {
    if (in_array('psp-same-day-question', (array) ($element['#wrapper_attributes']['class'] ?? []), TRUE)) {
      $form['#validate'][] = 'psp_request_service_same_day_validate';
      $form_state->set('psp_same_day_key', $key);
      break;
    }
  }

  // Service-address field: suggestions + zip from the chosen address.
  $elements = $webform->getElementsInitializedFlattenedAndHasValue();
  if (isset($elements['service_address'], $elements['zip'])) {
    $lookup = \Drupal::service('psp_request_service.address_lookup');
    $form['#attached']['library'][] = 'psp_request_service/address_lookup';
    $form['#attached']['drupalSettings']['pspAddress'] = [
      'available' => $lookup->isAvailable(),
      'suggest' => \Drupal\Core\Url::fromRoute('psp_request_service.address_suggest')->toString(),
      'place' => \Drupal\Core\Url::fromRoute('psp_request_service.address_place')->toString(),
      'attribution' => 'Powered by Google',
    ];
    $form['#cache']['tags'][] = 'config:psp_request_service.settings';
  }

  // Booking card styling: fields, trade-icon service buttons, the day picker
  // and the emergency answers, as in the form the booking card opens.
  // - Opened from the card (psp_card=1 on the share page URL): the panel's
  //   flat form, with icons when the card used them (psp_icons=1).
  // - Any webform listing psp-booking-style under Settings > Form > CSS
  //   classes (Book Online's own page): the same fields in a card-shaped form.
  $form['#cache']['contexts'][] = 'url.query_args:psp_card';
  $form['#cache']['contexts'][] = 'url.query_args:psp_icons';
  $request = \Drupal::request();
  $from_card = (bool) $request->query->get('psp_card');
  $standalone = !$from_card && in_array('psp-booking-style', $classes, TRUE);
  if ($from_card || $standalone) {
    $form['#attributes']['class'][] = 'psp-booking-embed';
    if ($standalone) {
      $form['#attributes']['class'][] = 'psp-booking-standalone';
    }
    $form['#attached']['library'][] = 'psp_request_service/booking_embed';
    if ($standalone || $request->query->get('psp_icons')) {
      foreach ($elements ?? $webform->getElementsInitializedFlattenedAndHasValue() as $key => $element) {
        if (isset($element['#options']) && ($element['#options_display'] ?? '') === 'buttons') {
          $icons = [];
          foreach (\Drupal\webform\Entity\WebformOptions::getElementOptions($element) as $value => $label) {
            if (is_string($label)) {
              $icon = \Drupal\psp_request_service\ServiceIcons::forLabel($label);
              $icons[(string) $value] = ['icon' => $icon, 'path' => \Drupal\psp_request_service\ServiceIcons::PATHS[$icon]];
            }
          }
          $form['#attached']['drupalSettings']['pspBookingIcons'] = ['name' => $key, 'icons' => $icons];
          break;
        }
      }
    }
  }
}

/**
 * Form validation: the same-day question is answered only for today's date.
 */
function psp_request_service_same_day_validate(array &$form, FormStateInterface $form_state): void {
  $key = $form_state->get('psp_same_day_key');
  $date = NULL;
  foreach ($form_state->getFormObject()->getEntity()->getWebform()->getElementsInitializedFlattenedAndHasValue() as $name => $element) {
    if (($element['#type'] ?? '') === 'date') {
      $date = (string) $form_state->getValue($name);
      break;
    }
  }
  $today = \Drupal::service('date.formatter')->format(\Drupal::time()->getRequestTime(), 'custom', 'Y-m-d');
  if ($date === $today) {
    if ((string) $form_state->getValue($key) === '') {
      $form_state->setErrorByName($key, t('Please tell us whether you need emergency service.'));
    }
  }
  else {
    $form_state->setValue($key, '');
  }
}

/**
 * Implements hook_webform_submission_presave().
 *
 * Multi-market sites: tags a new booking with its market (the zip's market
 * from psp_service_area's zip map, else the page's market the booking card
 * passed in, if it is a real one) and makes the lead source market-specific,
 * e.g. "Swift Brothers - Raleigh, NC". Per-market Avoca keys key off this.
 */
function psp_request_service_webform_submission_presave(\Drupal\webform\WebformSubmissionInterface $submission): void {
  if (!$submission->isNew() || !$submission->getWebform()->getElement('psp_market')) {
    return;
  }
  $markets = \Drupal\psp_request_service\FormConfigurator::markets();
  if (!$markets) {
    return;
  }
  $zip = substr(preg_replace('/\D+/', '', (string) $submission->getElementData('zip')), 0, 5);
  $map = (array) \Drupal::config('psp_service_area.zip_map')->get('map');
  $market = (string) ($map[$zip] ?? '');
  if (!isset($markets[$market])) {
    $given = trim((string) $submission->getElementData('psp_market'));
    $market = isset($markets[$given]) ? $given : '';
  }
  $submission->setElementData('psp_market', $market);
  if ($market !== '' && $submission->getWebform()->getElement('lead_source')) {
    $settings = \Drupal::config('psp_request_service.settings');
    $base = trim((string) $settings->get('lead_source')) ?: (trim((string) $settings->get('company_name')) ?: (string) \Drupal::config('system.site')->get('name'));
    $submission->setElementData('lead_source', $base . ' - ' . $markets[$market]);
  }
}
