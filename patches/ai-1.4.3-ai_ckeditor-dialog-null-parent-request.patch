Fix fatal "Call to a member function get() on null" opening AI CKEditor dialogs (drupal/ai 1.4.3).

AiCKEditorPluginBase::buildCkEditorModalForm() read editor_id from
getParentRequest(), which is NULL on the direct /api/ai-ckeditor/dialog
AJAX request. Backport of the 1.4.x-dev fix (settings -> current request
-> parent request, all guarded) + pass $settings through in the four
plugins that dropped it. Remove when drupal/ai > 1.4.3 lands.

--- a/modules/ai_ckeditor/src/AiCKEditorPluginBase.php
+++ b/modules/ai_ckeditor/src/AiCKEditorPluginBase.php
@@ -211,7 +211,13 @@
    * {@inheritdoc}
    */
   public function buildCkEditorModalForm(array $form, FormStateInterface $form_state, array $settings = []) {
-    $editor_id = $this->requestStack->getParentRequest()->get('editor_id');
+    $editor_id = $settings['editor_id'] ?? NULL;
+    if (!$editor_id && ($request = $this->requestStack->getCurrentRequest())) {
+      $editor_id = $request->query->get('editor_id') ?? $request->request->get('editor_id') ?? $request->attributes->get('editor_id');
+    }
+    if (!$editor_id && ($parent_request = $this->requestStack->getParentRequest())) {
+      $editor_id = $parent_request->query->get('editor_id') ?? $parent_request->request->get('editor_id') ?? $parent_request->attributes->get('editor_id');
+    }
     $storage = $form_state->getStorage();
     if ($this->needsSelectedText()) {
       if (empty($storage['selected_text'])) {
