{#
/**
 * @file
 * Skinny header location bar + collapsible location chooser.
 *
 * - current: ['label', 'prefix']|null — the area of the CURRENT PAGE
 *   (server-side). On global pages JS fills the display from the cookie.
 * - locations: list of ['label', 'prefix', 'url'].
 */
#}
<div class="psp-location-bar{{ current ? ' psp-location-bar--in-area' }}" data-current-area="{{ current ? current.prefix }}">
  <div class="psp-location-bar__inner">
    <span class="psp-location-bar__pin" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
    </span>
    <span class="psp-location-bar__label js-psp-location-label">
      {% if current %}
        {{ current.label }}
      {% else %}
        {{ 'Choose your location'|t }}
      {% endif %}
    </span>
    <button type="button" class="psp-location-bar__change js-psp-location-toggle" aria-expanded="false" aria-controls="psp-location-chooser">
      {% if current %}({{ 'change'|t }}){% else %}({{ 'select'|t }}){% endif %}
    </button>
  </div>

  <div class="psp-location-chooser" id="psp-location-chooser" hidden>
    <p class="psp-location-chooser__label">{{ 'Enter your ZIP code to see which location serves you:'|t }}</p>
    {{ include('psp_service_area:zip-search', {
      placeholder: 'Enter your ZIP code'|t,
      button_label: 'Find My Location'|t,
      center: true,
    }, with_context = false) }}
    <div class="psp-location-chooser__list">
      <span class="psp-location-chooser__list-label">{{ 'Or choose a location:'|t }}</span>
      <ul class="psp-location-chooser__locations">
        {% for location in locations %}
          <li><a href="{{ location.url }}" data-area-prefix="{{ location.prefix }}" class="button button--outline button--small js-psp-location-link">{{ location.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>
