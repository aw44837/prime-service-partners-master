{#
/**
 * @file
 * Replaces canvas:image to honour Focal Point.
 *
 * Identical to the Canvas original, plus an object-position taken from the
 * image's Focal Point crop (psp_focal_point module). Components that crop the
 * image in CSS (object-fit: cover — e.g. psp-hero-curve) then keep the focal
 * point in frame instead of always cropping around the centre.
 */
#}
{% set width = width ?? src|getWidth %}
{% set height = height ?? src|getHeight %}
{% set srcset = src|toSrcSet(width) %}
{% set focal = focal_point_position(src) %}
{{ focal.cache }}
{% if focal.position %}
  {% set attributes = attributes.setAttribute('style', (attributes.style ? attributes.style ~ '; ' : '') ~ 'object-position: ' ~ focal.position) %}
{% endif %}
{# Convert any stream wrapper image URL to a public, browser-resolvable URL. (No-op if not stream wrapper image URL. #}
{% set src = file_url(src) %}
<img
   class="{{ class ?? 'image' }}"
   src="{{ src }}"
   {% if srcset and srcset is not empty %}
     srcset="{{ srcset }}"
     sizes="{{ sizes ?? 'auto 100vw' }}"
   {% endif %}
   {% if alt %}
     alt="{{ alt }}"
   {% endif %}
   {% if width %}
     width="{{ width }}"
   {% endif %}
   {% if height %}
     height="{{ height }}"
   {% endif %}
   loading="{{ loading ?? 'lazy' }}"
   {{ attributes }}
/>
