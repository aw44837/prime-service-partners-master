{#
/**
 * @file
 * "Our [Brand] services" on a brand page: curated picks + tagged services.
 */
#}
<div class="psp-brand-services">
  <h2 class="psp-brand-links__heading">{{ heading }}</h2>
  {% if featured %}
    <ul class="psp-brand-links psp-brand-links--featured">
      {% for link in featured %}
        <li class="psp-brand-links__item">
          <a href="{{ link.url }}" class="psp-brand-links__featured-link">{{ link.title }}</a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  {% if links %}
    <ul class="psp-brand-links psp-brand-links--services">
      {% for link in links %}
        <li class="psp-brand-links__item">
          <a href="{{ link.url }}" class="psp-brand-links__link">{{ link.title }}</a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
